# Скопируйте в .env и заполните. Пустое значение = значение по умолчанию.

# --- Подключение к LLM (OpenAI-совместимый API) ---

# Ключ API. Обязателен; для локальной модели подойдёт любая непустая строка.
# Пример: sk-xxxxxxxxxxxxxxxx
LLM_API_KEY=

# Адрес API. Заполните: по умолчанию используется proxyapi.ru.
# Пример для Ollama: http://localhost:11434/v1
BASE_URL=

# Имя модели. Заполните: по умолчанию используется gpt-4.1.
# Пример: qwen3:8b
MODEL=

# --- Генерация ---

# Случайность ответа, от 0.0 до 1.0. Пример: 0.2
TEMPERATURE=

# Максимум токенов в ответе модели. Заполните: по умолчанию 80,
# этого мало для структурированного ответа. Пример: 1000
MAX_OUTPUT_TOKENS=

# Лимит токенов истории чата, отправляемой модели. Пример: 3000
CHAT_INPUT_TOKEN_BUDGET=

# --- Сеть ---

# Таймаут обычного запроса, в секундах. Пример: 60
REQUEST_TIMEOUT_SECONDS=

# Таймаут потоковой генерации, в секундах. Пример: 60
STREAM_TIMEOUT_SECONDS=

# Число повторов при сбое, от 0 до 5. Пример: 2
MAX_RETRIES=

# --- Приложение ---

# Окружение: development, test или production
APP_ENV=
